{
  "name": "cutting",
  "version": "4.4.0",
  "description": "Aplicativo premium para corte de vídeos",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test_backend.js",
    "dist": "electron-packager . Cutting --platform=win32 --arch=x64 --out=dist --overwrite --icon=build/icon.ico --app-copyright=\"© Lucas Gulich\" --asar.unpack=**/{ffmpeg-static,@ffprobe-installer}/**",
    "icone": "electron gerar-icone.js && node empacotar-icone.js"
  },
  "keywords": [
    "video",
    "cut",
    "trim",
    "ffmpeg",
    "electron"
  ],
  "author": "Lucas Gulich",
  "license": "ISC",
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-packager": "^17.1.2"
  }
}
